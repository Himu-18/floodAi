WEATHER_API_KEY=your_weather_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CORS_ORIGINS=http://localhost:5000
FLASK_DEBUG=0
CHAT_RATE_WINDOW_SECONDS=60
CHAT_RATE_MAX_REQUESTS=20

# Session cookie sign করার key — জেনারেট করতে:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_random_64_char_hex_string

# Login/Register rate limit (brute-force protection)
AUTH_RATE_WINDOW_SECONDS=300
AUTH_RATE_MAX_REQUESTS=8

# Community report rate limit + time window (spoofing/false-alarm প্রতিরোধ)
REPORT_RATE_WINDOW_SECONDS=300
REPORT_RATE_MAX_REQUESTS=5
REPORT_WINDOW_HOURS=6

# scheduler-only endpoint (/api/validation/collect) সুরক্ষিত রাখতে —
# ফাঁকা রাখলে endpoint public-ই থাকবে (backward-compatible)
VALIDATION_COLLECT_SECRET=

# Local dev-এ http-এর উপর টেস্ট করলে 1 রাখো (Secure cookie বন্ধ থাকবে)।
# Render production-এ FLASK_DEBUG=0 থাকলে এমনিতেই Secure=1 হয়ে যায়।
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0
FFWC_LIVE_CACHE_TTL_SECONDS=1800
WORLDTIDES_API_KEY=your_worldtides_api_key_here
TIDE_CACHE_TTL_SECONDS=43200
